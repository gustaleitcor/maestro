# Copy to .env (next to docker-compose.yml) and fill in. .env is not committed.

# The OpenID Connect provider Maestro signs users in with. The issuer must
# serve <issuer>/.well-known/openid-configuration.
OIDC_ISSUER=https://auth.logsad.com
OIDC_CLIENT_ID=maestro
OIDC_CLIENT_SECRET=
# Must be registered with the provider, and must reach maestro-orq.
OIDC_REDIRECT_URL=https://maestro.logsad.com/api/auth/callback

# Where sessions are kept: Redis, Valkey or KeyDB, reachable from the orq
# container. redis://[:password@]host:port/db
REDIS_URL=redis://host.containers.internal:6379

# Encrypts the SSH keys of the machines admins add. At least 32 characters,
# e.g. `openssl rand -base64 32`. Changing it makes the stored keys unreadable.
MACHINE_SECRET=
