# Copy to .env (next to docker-compose.yml) and fill in. .env is not committed.

# The OpenID Connect provider Maestro signs users in with. The issuer must
# serve <issuer>/.well-known/openid-configuration.
OIDC_ISSUER=https://auth.logsad.com
OIDC_CLIENT_ID=maestro
OIDC_CLIENT_SECRET=
# Must be registered with the provider, and must reach maestro-orq.
OIDC_REDIRECT_URL=https://maestro.logsad.com/api/auth/callback

# Where sessions are kept: Redis, Valkey or KeyDB, reachable from the orq
# container. redis://:password@host:port/db
# Whoever can write to it can sign in as anyone, so it needs a password. Make
# one with `openssl rand -hex 32`, which needs no escaping in a URL. Set it on
# the Redis first, with `--requirepass <password>` in its command or
# `requirepass <password>` in its redis.conf, then put it here. When the Redis
# belongs to another compose project, its owner sets it there. orq warns at
# start while REDIS_URL has no password.
REDIS_URL=redis://:CHANGE_ME@host.containers.internal:6379

# Encrypts the SSH keys of the machines admins add. At least 32 characters,
# e.g. `openssl rand -base64 32`. Changing it makes the stored keys unreadable.
MACHINE_SECRET=

# Allows machines reached through a proxy command, such as cloudflared for
# Cloudflare Access. The command runs inside orq's container, so this lets
# administrators run programs on the server.
MACHINE_PROXY_COMMANDS=false
